# Public HTTPS URL to this server's /mcp endpoint
RESOURCE_SERVER_URL=https://unscaled-kenny-unicellular.ngrok-free.dev/mcp

# Adobe IMS base URL and userinfo endpoints (na1 by default) - matching server.py variable names
ADOBE_OPENID_ISSUER=https://ims-na1.adobelogin.com
ADOBE_USERINFO=https://ims-na1.adobelogin.com/ims/userinfo/v2

# Your Adobe OAuth Web App Client ID and Secret
ADOBE_CLIENT_ID=fillin
ADOBE_CLIENT_SECRET=fillin

# Scopes requested by ChatGPT during OAuth (Adobe-specific scopes)
REQUIRED_SCOPES=AdobeID,openid,read_organizations,additional_info.projectedProductContext,additional_info.job_function
